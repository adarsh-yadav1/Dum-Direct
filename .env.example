# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file. Only variable names belong in version control.

# Runtime mode: development or production
ENV=development

# Backend
DATABASE_URL=postgresql+psycopg://dumdirect:change-me@localhost:5432/dumdirect
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Frontend (build-time)
VITE_API_BASE_URL=http://localhost:8000

# Docker Compose database container
POSTGRES_USER=dumdirect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dumdirect
