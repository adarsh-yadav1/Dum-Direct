# ---------------------------------------------------------------
# DumDirect .gitignore
# Covers: secrets, Python/FastAPI backend, Node/React frontend,
# Docker, test and build output, editors and operating systems.
# ---------------------------------------------------------------

# ----- Secrets and environment files (never commit real values) -----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json

# ----- Python / FastAPI backend -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ----- Node / React / Vite frontend -----
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Keep lock files (package-lock.json, pnpm-lock.yaml) committed for reproducible installs.

# ----- Local databases and data volumes -----
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/
redis-data/
dump.rdb

# ----- Docker -----
docker-compose.override.yml
.docker/

# ----- Logs and temporary files -----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# ----- Load test and report output -----
scripts/results/
*.har

# ----- Local uploads (use seeded or licensed images only) -----
uploads/
media/

# ----- Submission package (build it outside version control) -----
*.zip
submission/

# ----- Editors and IDEs -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml

# ----- Operating systems -----
.DS_Store
Thumbs.db
Desktop.ini
